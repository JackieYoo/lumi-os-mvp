# LumiOS MVP 环境变量

# 服务器
PORT=3000
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
DATABASE_PATH=./data/lumi-mvp.db

# LLM API Keys（至少填一个）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
XIAOMI_API_KEY=

# 本地模型
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# 可选：自定义各家 base URL（未设置时使用默认值）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# XIAOMI_BASE_URL=https://api.mi.com/open-ai/v1

# 中转站（OpenAI 兼容接口）
# 如果你使用第三方聚合/中转服务，填写以下三项，并在前端选择 provider: relay
CUSTOM_RELAY_BASE_URL=https://api.your-relay.com/v1
CUSTOM_RELAY_API_KEY=your-relay-api-key
CUSTOM_RELAY_MODEL=gpt-4o-mini
